{
  // Pick a configuration in the Run and Debug tab, then press F5.
  // The target device is the one shown in the VS Code status bar.
  //
  // Debug and profile builds install a separate "LIT Dev" app
  // (com.lactationinductiontracker.app.dev) with its own data, so testing
  // never touches the real app. Use "LIT (release)" to install or update
  // the real app on your phone.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LIT Dev (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "LIT Dev (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      // Signed with your release key (android/key.properties).
      "name": "LIT (release) · real app",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release"
    },
    {
      // Quick UI preview in the browser. Reminders don't work on web.
      "name": "LIT (Chrome preview)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    }
  ]
}
