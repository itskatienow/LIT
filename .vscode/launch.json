{
  // Pick a configuration in the Run and Debug tab, then press F5.
  // The target device is the one shown in the VS Code status bar.
  //
  // These install the separate "LIT Dev" app
  // (com.lactationinductiontracker.app.dev), which has its own data, so
  // testing never touches the real app.
  //
  // To install or update the REAL app, press Ctrl+Shift+B (task "Install LIT
  // on phone"). Don't use a release run from here: stopping a run session
  // force-stops the app, which makes Android delete its scheduled reminders.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LIT Dev (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "LIT Dev (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      // Quick UI preview in the browser. Reminders don't work on web.
      "name": "LIT (Chrome preview)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    }
  ]
}
